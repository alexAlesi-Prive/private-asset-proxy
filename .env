# Copy to .env and adjust as needed. .env is git-ignored.
# The service runs with sensible defaults, so every value here is optional.

# Port the service listens on (host and container).
PORT=5530

# Where user-added private holdings are persisted inside the container.
# Kept on the psi-private-asset-proxy-data volume; change only if you also
# change the volume mount in docker-compose.yml.
PRIVATE_ASSETS_FILE=/app/var/private_assets.json
